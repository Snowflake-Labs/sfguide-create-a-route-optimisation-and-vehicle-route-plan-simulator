# Snowflake connection (local dev). In SPCS these are auto-injected
# (SNOWFLAKE_HOST + /snowflake/session/token), and IS_SPCS becomes true.
SNOWFLAKE_HOST=
SNOWFLAKE_CONNECTION=fleet_test_evals
SNOWFLAKE_DATABASE=OPENROUTESERVICE_APP
SNOWFLAKE_WAREHOUSE=MY_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# App metadata
APP_VERSION=0.0.0
LOG_LEVEL=info
