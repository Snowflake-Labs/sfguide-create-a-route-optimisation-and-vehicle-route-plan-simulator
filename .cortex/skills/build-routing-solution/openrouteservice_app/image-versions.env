# Single source of truth for all SPCS image tags.
# deploy.sh bumps these; check_image_versions.sh validates
# all other files match. The skill agent reads this at build time.
OPENROUTESERVICE_TAG=v9.0.0
DOWNLOADER_TAG=v0.0.6
ROUTING_REVERSE_PROXY_TAG=v1.1.5
VROOM_DOCKER_TAG=v1.0.4
ORS_CONTROL_APP_TAG=v1.1.102

# Fleet Intelligence SA host (Solution Accelerator UI). Deployed via
# scripts/deploy_fleet_sa_app.sh (sibling one-command flow). The SA host lives
# under fleet_sa_app/ (separate from the ORS control app services), so it is NOT
# part of the ORS check_image_versions.sh validation arrays; deploy_fleet_sa_app.sh
# validates fleet_sa_app_service.yaml against this tag in its own pre-flight.
FLEET_SA_APP_TAG=v0.1.2

# Upstream base image versions (pinned to avoid pulling broken releases).
# Bump procedure: test locally with `docker run <image>:<new_tag>`, then
# rebuild and push the corresponding SPCS image.
OPENROUTESERVICE_BASE_TAG=v9.0.0
VROOM_BASE_TAG=v1.14.0
