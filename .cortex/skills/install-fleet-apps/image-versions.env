# Single source of truth for the install-fleet-apps SPCS image tags.
# Only the two app images belong to this skill. The ORS/VROOM/gateway engine
# image tags remain owned by build-routing-solution (secondary, delegated).
# deploy_fleet_sa_app.sh / deploy_fleet_admin_app.sh read these at build time
# and validate the committed service YAMLs against them in pre-flight.

# Fleet Intelligence SA host (consumer Solution Accelerator UI).
FLEET_SA_APP_TAG=v0.1.13

# Routing Platform Admin/Build console (Next 15 + @fleet-kit/core).
FLEET_ADMIN_APP_TAG=v0.1.2
