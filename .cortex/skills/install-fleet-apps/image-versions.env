# Single source of truth for ALL install-fleet-apps SPCS image tags.
# This skill owns both the two app images AND (since Phase C) the four ORS/VROOM
# engine images. deploy_fleet_sa_app.sh / deploy_fleet_admin_app.sh read the app
# tags at build time; provision_engine.sh reads the engine tags; and
# check_image_versions.sh validates the committed service YAMLs against all of
# them in pre-flight.

# ── ORS routing engine images (provisioned by scripts/provision_engine.sh) ──
# Built from openrouteservice_app/services/{openrouteservice,downloader,gateway,vroom}/.
OPENROUTESERVICE_TAG=v9.10.0
DOWNLOADER_TAG=v0.0.11
ROUTING_REVERSE_PROXY_TAG=v1.1.15
VROOM_DOCKER_TAG=v1.0.4

# Upstream base image versions (pinned to avoid pulling broken releases).
# Bump procedure: test locally with `docker run <image>:<new_tag>`, then
# rebuild and push the corresponding SPCS image.
OPENROUTESERVICE_BASE_TAG=v9.10.0
VROOM_BASE_TAG=v1.14.0


# Fleet Intelligence SA host (consumer Solution Accelerator UI).
#
# ROLLBACK CAVEAT: the registry's v0.1.136 is NOT the image commit 2fd00ff9
# describes. A deploy re-pushed that tag from an unidentified working tree (the
# tag was read during a transient clean-tree window before the v0.1.137 bump), so
# the tag was overwritten and its contents cannot be reproduced from git history.
# v0.1.137 is the first SA tag whose image provenance is known. Do not roll back
# past it - rebuild from a known checkout under a fresh tag instead.
FLEET_SA_APP_TAG=v0.1.140

# Routing Platform Admin/Build console (Next 15 + @fleet-kit/core).
FLEET_ADMIN_APP_TAG=v0.1.66
