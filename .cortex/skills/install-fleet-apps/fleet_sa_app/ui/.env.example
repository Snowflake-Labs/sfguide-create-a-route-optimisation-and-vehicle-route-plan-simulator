# Snowflake connection
SNOWFLAKE_ACCOUNT_URL=https://YOUR_ACCOUNT.snowflakecomputing.com
SNOWFLAKE_PAT=your-programmatic-access-token
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Agent mode: "agentless" (inline config) or "agent-object" (reference Snowflake agent)
AGENT_MODE=agentless

# Agentless mode settings
AGENT_MODEL=claude-4-sonnet
AGENT_RESPONSE_INSTRUCTIONS=You are a helpful data app assistant. Be concise and clear.
AGENT_ORCHESTRATION_INSTRUCTIONS=

# Tools config file (JSON) — defines Cortex Analyst, Search, custom tools
# Path relative to ui/ or absolute. Points to an app-specific file.
# AGENT_TOOLS_CONFIG=../../my-app/agent-tools.json

# Agent object mode settings (used when AGENT_MODE=agent-object)
# AGENT_DATABASE=MY_DB
# AGENT_SCHEMA=MY_SCHEMA
# AGENT_NAME=MY_AGENT

# App-specific view config (JSON). Path relative to ui/ or absolute.
# Points to the app's app-views.json (converted from ui-views.yaml).
# If not set, the panel starts with no views (chat-only mode).
# APP_VIEWS_CONFIG=../../my-app/app-views.json

# App metadata (JSON). Provides app name, description, target users, capabilities,
# and sample questions. Used by the header, about dialog, and welcome screen.
# If not set, the app shows "Data App" as the title with no about content.
# APP_CONFIG=../../my-app/app-config.json
