# Ignore the 'output' folder
/Native_app/output

# Log files (ad-hoc redirects, build output)
*.log

# Per-run friction/error logs are local artifacts, not source. Keep README.md.
**/logs/*.md
!**/logs/README.md

# Environment and secrets
.env
*.p8
*.pem
rsa_key*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Node / React
node_modules/
package-lock.json
tsconfig.tsbuildinfo

# Distribution
dist/
dist-server/
build/
*.egg-info/

# Vendored synapse framework: we now vendor SOURCE and build it locally with tsc
# (see fleet_tools/vendor/synapse/VENDOR.md), so `dist/` is generated output and
# stays ignored by the global rule above. The framework's own `src/build/` module
# would otherwise be swallowed by the generic `build/` rule, so un-ignore it
# explicitly - it holds the patched ddl.ts and its loss is silent.
!.cortex/skills/install-fleet-apps/fleet_tools/vendor/synapse/src/build/
!.cortex/skills/install-fleet-apps/fleet_tools/vendor/synapse/src/build/**

# Shared UI kit (@fleet-kit/core): ship its built dist so both apps can consume it
# from a fresh clone via a relative file: dependency.
!packages/fleet-kit/dist/
!packages/fleet-kit/dist/**

# Next.js build output (SA host)
**/.next/

# synapse materialize generated outputs (install.json is kept as source config)
**/_installed/**/install.sql
**/_installed/**/install.json
**/_installed/**/runtime.js
**/_installed/**/server.js
**/_installed/**/package.json
**/_installed/**/.claude-plugin/

# Cortex Code session artifacts
.snowflake/cortex/plans/
drafts/FINAL.md
drafts/PLAN.md
drafts/v1-critique.md
drafts/v1.md
drafts/v2-critique.md
drafts/v2.md
/docs/blogpost
/docs/old
benchmarks/matrix-access/results/blogpost-blurb.md
/tmp

# Agent behavioral eval run artifacts
.cortex/skills/evals/results/agent/
