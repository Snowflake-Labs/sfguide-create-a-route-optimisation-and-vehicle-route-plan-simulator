#!/usr/bin/env bash
# Optional local hook: git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

SKILL_DIR=".cortex/skills/install-fleet-apps"
STAGED=$(git diff --cached --name-only)

# True when any staged path starts with one of the given prefixes. Uses an `if`
# condition (never `cmd && return`) so a non-match cannot trip `set -e`.
staged_any() {
  local prefix
  for prefix in "$@"; do
    if echo "$STAGED" | grep -q "^${prefix}"; then
      return 0
    fi
  done
  return 1
}

# ── 1. Image tag consistency ────────────────────────────────────
IMAGE_CHECK="$SKILL_DIR/scripts/check_image_versions.sh"
if [ -f "$IMAGE_CHECK" ] && staged_any \
  "$SKILL_DIR/image-versions.env" \
  "$SKILL_DIR/openrouteservice_app/services/" \
  "$SKILL_DIR/openrouteservice_app/app/modules/" \
  "$SKILL_DIR/references/snowflake-scripting-guidelines.md"; then
  echo "pre-commit: image version consistency check..."
  bash "$IMAGE_CHECK" || {
    echo "pre-commit FAILED: fix image tag drift (see image-versions.env), then re-commit."
    exit 1
  }
fi

# ── 2b. Agent-side solution catalog must match app-views.json ─────────────────
# view_catalog.sql is generated from the useCase / agentKnowledge blocks and is
# what Cowork / Snowflake Intelligence reads (outside the app there is no
# request-time catalog prefix). A stale file means the agent recommends views the
# app no longer serves, or omits new ones - and nothing else would notice.
CATALOG_BUILD="$SKILL_DIR/scripts/build_view_catalog.py"
if [ -f "$CATALOG_BUILD" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/app/app-config.json" \
  "$SKILL_DIR/fleet_sa_app/app/view_catalog.sql" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/packs/fleet/pack-views.json" \
  "$SKILL_DIR/scripts/build_view_catalog.py"; then
  echo "pre-commit: solution-catalog freshness check..."
  python3 "$CATALOG_BUILD" --check || {
    echo "pre-commit FAILED: view_catalog.sql is stale - run python3 $CATALOG_BUILD"
    exit 1
  }
fi

# ── 1b. Super agent spec freshness ──────────────────────────────
# super-agent-spec.json is generated from agent-spec.json PLUS the ops/admin
# specs, whose per-verb routing sections are lifted verbatim. Two hand-maintained
# copies of a 12,000-character instruction block drift within a release, and the
# drift is invisible until the two agents answer the same question differently.
# The ops/admin specs MUST be in this trigger list: they are now inputs, so a
# commit touching only ops-agent-spec.json would otherwise skip the check and
# leave the super agent describing the old routing.
# -- 2c. CoWork skills freshness + CoWork surface wiring -----------------------
# The 26 SKILL.md folders and the 26-entry `skills` array in the agent spec are
# GENERATED from the same useCase blocks as the view catalog, so a stale copy
# means the agent advertises a workflow that no longer matches the view - or
# points at a stage folder that no longer exists, which fails per request.
COWORK_SKILLS_BUILD="$SKILL_DIR/scripts/build_cowork_skills.py"
if [ -f "$COWORK_SKILLS_BUILD" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/app/app-config.json" \
  "$SKILL_DIR/fleet_sa_app/app/agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/cowork_skills" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/packs/fleet/pack-views.json" \
  "$SKILL_DIR/scripts/build_cowork_skills.py"; then
  echo "pre-commit: CoWork skills freshness check..."
  python3 "$COWORK_SKILLS_BUILD" --check || {
    echo "pre-commit FAILED: CoWork skills are stale - run python3 $COWORK_SKILLS_BUILD"
    exit 1
  }
fi

# Every CoWork-facing failure in this class is SILENT: an agent with no sandbox
# tool just cannot produce a file, a view with no verified query just regenerates
# SQL, a broken vega_template is merged into every chart and reported nowhere.
COWORK_CHECK="$SKILL_DIR/scripts/check_cowork_surfaces.py"
if [ -f "$COWORK_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/ops-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/admin-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/super-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/semantic_views.sql" \
  "$SKILL_DIR/fleet_sa_app/app/semantic_views_emergency.sql" \
  "$SKILL_DIR/fleet_sa_app/app/cowork_skills" \
  "$SKILL_DIR/scripts/verified_queries.py" \
  "$SKILL_DIR/scripts/check_cowork_surfaces.py"; then
  echo "pre-commit: CoWork surface wiring check..."
  python3 "$COWORK_CHECK" || {
    echo "pre-commit FAILED: see the rules above"
    exit 1
  }
fi

SUPER_BUILD="$SKILL_DIR/scripts/build_super_agent_spec.py"
if [ -f "$SUPER_BUILD" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/ops-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/admin-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/super-agent-spec.json" \
  "$SKILL_DIR/scripts/build_super_agent_spec.py"; then
  echo "pre-commit: super agent spec freshness check..."
  python3 "$SUPER_BUILD" --check || {
    echo "pre-commit FAILED: super-agent-spec.json is stale - run python3 $SUPER_BUILD"
    exit 1
  }
fi

# ── 1b2. data_to_chart must state what it accepts ───────────────────────────────
# data_to_chart and data_to_map are HOST-INJECTED and accept only a SQL or Cortex
# Analyst result as tool_result_id; an MCP verb result is rejected. The specs said
# so for maps and nothing for charts, and the tool description ("tabular data
# returned by the analytics tools") read as though any verb result would do.
# Measured cost of that missing sentence: a turn that produced NO ANSWER. The agent
# solved backload_solve, was pushed at a chart by the host's own "charts are
# MANDATORY for 2+ numeric rows" guidance, had only an MCP tool_use_id to offer,
# and ended the turn after 125 s and 3,979 output tokens with no prose at all.
# Nothing catches this: the rule is prose inside a single-line JSON string that four
# specs share, --check above proves the super spec is CURRENT and not CORRECT, and
# deleting the sentence fails no build and raises no error. It produces silence.
CHART_SOURCE_CHECK="$SKILL_DIR/scripts/check_chart_source_constraint.py"
if [ -f "$CHART_SOURCE_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/ops-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/admin-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/super-agent-spec.json" \
  "$SKILL_DIR/scripts/check_chart_source_constraint.py"; then
  echo "pre-commit: data_to_chart source constraint check..."
  python3 "$CHART_SOURCE_CHECK" || exit 1
fi

# ── 1b2b. The client must be able to RENDER the chart it just asked for ───────
# The sibling of the rule above, one layer out. 1b2 guarantees the agent CALLS
# data_to_chart correctly; this guarantees the SA app draws the result. It did
# not, ever: the inline registry knew `render_chart` (a name only the unused
# `response.chart` SSE branch produces) while the real result streams as
# `data_to_chart`, and an unregistered tool is a LEGAL state that falls through
# to the collapsed JSON viewer. So every bar, line and pie the agent produced
# rendered as a tidy "> Tool result" blob and nothing failed - maps escaped only
# because `render_map` happens to be registered under the name it arrives with.
# Same silent class as the routing_mcp_render_map separator bug. Also pins the
# payload key (charts is an ARRAY), the theme merge DIRECTION (spec must win over
# the app theme, or the agent's sort and colours are quietly overridden), the
# citation stripping (react-markdown has no rehype-raw, so <chart>ID</chart> is
# swallowed without trace), and the lazy boundary that keeps vega out of the
# initial bundle.
CHART_RENDER_CHECK="$SKILL_DIR/scripts/check_chart_rendering.py"
if [ -f "$CHART_RENDER_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/tool-names.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/chart-spec.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/vega-theme.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/chart-citations.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/cortex-stream.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/components/inline/index.ts" \
  "$SKILL_DIR/fleet_sa_app/ui/src/components/inline/chart-inline.tsx" \
  "$SKILL_DIR/fleet_sa_app/ui/src/components/inline/chart-deferred.tsx" \
  "$SKILL_DIR/fleet_sa_app/ui/src/components/chat/message-part.tsx" \
  "$SKILL_DIR/fleet_sa_app/ui/src/components/chat/message-list.tsx" \
  "$SKILL_DIR/scripts/check_chart_rendering.py"; then
  echo "pre-commit: inline chart rendering check..."
  python3 "$CHART_RENDER_CHECK" || exit 1
fi

# ── 1b3. A forbidden map must name the tool that can draw one ───────────────────
# render_map shipped fully working and the agent never called it: asked to show
# dwell density it drew two facility-type bar charts and handed off to a link. Two
# semantic views' chart_customization blocks were PROHIBITIONS WITH NO ALTERNATIVE
# ("H3 congestion is a MAP, not a chart", "A path or a route is a MAP ... never a
# chart") - each correctly refuses the chart and then stops. Alongside a
# host-injected chart skill that says maps cannot be created at all, the agent's
# most salient local instructions read "do not chart this, and maps do not work".
# Naming the tool is what turns a dead end into a path. Same failure class as 1b2:
# a missing sentence in prose no test reads, which produces a bar chart where a map
# belongs. Also checks the trigger words that make the geometry get SELECTed at all
# - "density" was absent, so the analyst never fetched h3_cell and no map was
# possible however good the map guidance was.
MAP_GUIDANCE_CHECK="$SKILL_DIR/scripts/check_map_guidance.py"
if [ -f "$MAP_GUIDANCE_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/semantic_views.sql" \
  "$SKILL_DIR/fleet_sa_app/app/semantic_views_emergency.sql" \
  "$SKILL_DIR/scripts/check_map_guidance.py"; then
  echo "pre-commit: map guidance check..."
  python3 "$MAP_GUIDANCE_CHECK" || exit 1
fi

# ── 1c. Every synapse verb must be routed by the agents that can see it ────────
# Verbs are AUTO-DISCOVERED: `npx synapse deploy` walks src/procs/ and publishes
# each one, and the specs attach whole MCP servers with no tool allowlist, so a new
# verb is instantly visible to every agent on that bundle. Visible is not used
# well - with no routing line the model either ignores the verb or prefers it over
# a better tool (the documented hazard being run_sql winning over a query_* Cortex
# Analyst tool, silently bypassing the governed semantic-view path). Nothing fails
# either way, which is why this needs a gate: four verbs had already shipped
# unguided, including an ops audit verb the SUPER agent documented and the OPS
# agent that owns it did not.
VERB_COVERAGE="$SKILL_DIR/scripts/check_agent_verb_coverage.py"
if [ -f "$VERB_COVERAGE" ] && staged_any \
  "$SKILL_DIR/fleet_tools/user/src/procs" \
  "$SKILL_DIR/fleet_tools/ops/src/procs" \
  "$SKILL_DIR/fleet_tools/admin/src/procs" \
  "$SKILL_DIR/fleet_sa_app/app/agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/ops-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/admin-agent-spec.json" \
  "$SKILL_DIR/fleet_sa_app/app/super-agent-spec.json" \
  "$SKILL_DIR/scripts/check_agent_verb_coverage.py"; then
  echo "pre-commit: agent verb coverage check..."
  python3 "$VERB_COVERAGE" || {
    echo "pre-commit FAILED: a synapse verb has no routing guidance - see above"
    exit 1
  }
fi

# ── 2. View useCase coverage (Tenet 10, Channel D) ──────────────
# A view with no useCase renders fine but shows no "i" overlay and is invisible
# to the chat agent's solution catalog, so the failure is silent without a check.
USECASE_CHECK="$SKILL_DIR/scripts/check_view_usecases.py"
if [ -f "$USECASE_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/app/starter/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/packs/fleet/pack-views.json" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/packs/fleet/index.ts"; then
  echo "pre-commit: view useCase coverage check..."
  python3 "$USECASE_CHECK" || {
    echo "pre-commit FAILED: every view needs a useCase block (see TENETS.md tenet 10)."
    exit 1
  }
fi

# ── 2c. Authored tokens must land on interpolated paths ─────────────────────
# A {{labels.x}} token on a field the renderer does not interpolate prints its own
# braces on screen. Nothing errors - the query runs and the numbers are right -
# which is how a chart legend reading "{{labels.operator_plural}}: 32" reached a
# live account. Default-deny by path: a new token-bearing field fails until its
# render site is verified and recorded.
TOKEN_CHECK="$SKILL_DIR/scripts/check_view_tokens.py"
if [ -f "$TOKEN_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/packs/fleet/pack-views.json" \
  "$SKILL_DIR/scripts/check_view_tokens.py"; then
  echo "pre-commit: authored token interpolation check..."
  python3 "$TOKEN_CHECK" || {
    echo "pre-commit FAILED: a {{...}} token sits on a field rendered raw."
    exit 1
  }
fi

# ── 3. Live-routing views must fail loudly on a suspended engine ─────────────
# A suspended ORS service does not throw: it returns NULL payloads, so a view
# that filters those away renders BLANK instead of triggering the app's
# auto-resume + "engine starting" notice. Silent by construction, hence a check.
ORS_RAISE_CHECK="$SKILL_DIR/scripts/check_ors_raise.py"
if [ -f "$ORS_RAISE_CHECK" ] && staged_any \
  "$SKILL_DIR/fleet_sa_app/app/app-views.json" \
  "$SKILL_DIR/fleet_sa_app/app/starter/app-views.json" \
  "$SKILL_DIR/scripts/analytic_layer.sql" \
  "$SKILL_DIR/scripts/delivery_sync_layer.sql" \
  "$SKILL_DIR/scripts/analytic_layer_live_routing.sql"; then
  echo "pre-commit: suspended-ORS raise coverage check..."
  python3 "$ORS_RAISE_CHECK" || {
    echo "pre-commit FAILED: a live-routing view would render blank on a suspended engine."
    exit 1
  }
fi

# ── 4. Gateway error codes must be visible to the suspend detector ────────────
# The gateway has several codes for "region cannot serve this request"
# (service_unreachable / circuit_open / timeout / service_warming_up). Any code
# the client cannot classify means no typed 503, no auto-resume, and a blank or
# raw-error panel while the engine stays suspended. Adding a code without
# deciding how it is classified is the exact regression this catches.
SUSPEND_SIG_CHECK="$SKILL_DIR/scripts/check_suspend_signatures.py"
if [ -f "$SUSPEND_SIG_CHECK" ] && staged_any \
  "$SKILL_DIR/openrouteservice_app/services/gateway/routing_service.py" \
  "$SKILL_DIR/fleet_sa_app/ui/src/lib/routing-suspend.ts" \
  "$SKILL_DIR/scripts/check_suspend_signatures.py"; then
  echo "pre-commit: gateway error-code coverage check..."
  python3 "$SUSPEND_SIG_CHECK" || {
    echo "pre-commit FAILED: a gateway error code is invisible to the suspend detector."
    exit 1
  }
fi

# ── 5. No install SQL may reference an object a LATER step creates ────────────
# `IF EXISTS` covers an object but NOT its database, and `snow sql -f` stops at the
# first error - so one forward reference at the top of a file silently skips every
# statement below it. That is how a bare
# `DROP VIEW IF EXISTS FLEET_APP.UNIFIED_FLEET.VW_VEHICLE_PROFILE` in the step-2.5
# catalog left DIM_VEHICLE_DWELL_SLA unseeded, blanked Delivery Sync and broke the
# packs, on fresh accounts only, while the installer reported OK.
INSTALL_ORDER_CHECK="$SKILL_DIR/scripts/check_install_order.py"
if [ -f "$INSTALL_ORDER_CHECK" ] && staged_any \
  "$SKILL_DIR/scripts" \
  "$SKILL_DIR/fleet_sa_app/app/packs" \
  "$SKILL_DIR/fleet_sa_app/app/scoped_contract.sql" \
  "$SKILL_DIR/fleet_sa_app/app/semantic_views.sql" \
  "$SKILL_DIR/fleet_sa_app/app/role_binding.sql" \
  "$SKILL_DIR/openrouteservice_app/app/modules"; then
  echo "pre-commit: install-order (forward reference) check..."
  python3 "$INSTALL_ORDER_CHECK" || {
    echo "pre-commit FAILED: an install SQL file references an object a later step creates."
    exit 1
  }
fi

# ── 5b. Engine-free installer SQL must not create engine-dependent objects ────
# A `LANGUAGE SQL` UDTF body resolves at CREATE time, so a statement calling
# OPENROUTESERVICE_APP.CORE.ISOCHRONES / MATRIX_TABULAR / DIRECTIONS is a hard
# error on an engine-less install - and `snow sql -f` stop-on-first-error then
# abandons every later statement in that file. That cost analytic_layer.sql ~129
# statements (it died at line 1072 of 2722) and delivery_sync_layer.sql 33 of 44,
# in both cases silently discarding engine-FREE schemas (FLEET_INTELLIGENCE.SOURCING,
# FLEET_APP.SOURCING, FLEET_APP.DELIVERY_SYNC) that have nothing to do with routing.
# Those statements now live in scripts/analytic_layer_live_routing.sql; this keeps
# them there. Note the usual EXECUTE IMMEDIATE / EXCEPTION wrapper is NOT an option
# for them - they carry dollar-quoted bodies and dollar-quotes do not nest.
ENGINE_GUARDS_CHECK="$SKILL_DIR/scripts/check_engine_guards.py"
if [ -f "$ENGINE_GUARDS_CHECK" ] && staged_any \
  "$SKILL_DIR/scripts" \
  "$SKILL_DIR/fleet_sa_app/app" \
  "$SKILL_DIR/openrouteservice_app/app/modules"; then
  echo "pre-commit: engine-guards (engine-free installer SQL) check..."
  python3 "$ENGINE_GUARDS_CHECK" || {
    echo "pre-commit FAILED: engine-free installer SQL creates an object that needs the routing engine."
    echo "  Move the statement to scripts/analytic_layer_live_routing.sql."
    exit 1
  }
fi

# ── 6. Tracking tags (session query_tag + object COMMENT) ─────────────────────
# Both mechanisms are invisible at runtime: an untagged object works perfectly and
# an untagged session returns the right rows. What breaks is downstream - credit
# attribution by origin, and the cleanup skill (routing-solution-cleanup), which
# discovers objects to drop ONLY by their COMMENT tag. An untagged SPCS service or
# compute pool therefore survives a teardown and keeps billing.
# Also catches the subtler schema drift: a `"version":"1.0"` string instead of
# `{"major":1,"minor":0}`, or a missing `is_quickstart`/`source`. Those parse fine
# and look correct, but a consumer filtering on them matches none of the objects.
# Wide trigger on purpose - the tags live in SQL, shell, Python and notebooks - and
# the check prunes its own walk so it runs in about a second.
TRACKING_CHECK="$SKILL_DIR/scripts/check_tracking_tags.py"
if [ -f "$TRACKING_CHECK" ] && staged_any \
  ".cortex/skills/" \
  "benchmarks/" \
  "datasets/" \
  "docs/" \
  "semantic/"; then
  echo "pre-commit: tracking tag coverage check..."
  python3 "$TRACKING_CHECK" || {
    echo "pre-commit FAILED: a session or created object is missing its tracking tag, or a tag has the wrong schema (see AGENTS.md 'Do NOT')."
    exit 1
  }
fi

# ── 7. Brand neutrality (customer / vendor / competitor / individual names) ────
# Every view, demo, dataset and agent answer must be brand-neutral. This is not a
# style rule: three real leaks existed before the check was added, and none of
# them failed anything. A seed script wrote freight-exchange brand names straight
# into the offer SOURCE column, the shipped notebook seeded 30 rows with brands in
# the human-readable listing text, and an agent tool advertised eight vendor names
# as filter values the data never held.
# Runs on EVERY commit, with no staged-path filter: a brand can be reintroduced in
# prose, in SQL, in a notebook or in an agent spec, so scoping the trigger would
# just leave a gap. It prunes its own walk and takes about a second.
BRAND_CHECK="$SKILL_DIR/scripts/check_no_brands.py"
if [ -f "$BRAND_CHECK" ]; then
  echo "pre-commit: brand neutrality check..."
  python3 "$BRAND_CHECK" || {
    echo "pre-commit FAILED: a customer, vendor, competitor or individual name was found."
    exit 1
  }
fi

# 8. Region scoping: no contract view pinned to ONE region by a singleton CONFIG
# row, and every semantic view over a multi-region fact models region PLUS a
# readable label.
#
# This whole class of failure is SILENT. A view filtered to one region returns
# rows, compiles, and renders a populated panel - nothing distinguishes "this
# region has no data" from "this region was excluded before the first aggregate".
# It cost a CoWork answer of "there is no San Francisco data" while 15,091 San
# Francisco dwell sessions sat in the view, and because the CONFIG row is
# writable at runtime (including by an agent calling set_active_context) the same
# question returned different data at different times.
#
# The label rule is what actually closes the bug: region keys are CamelCase
# identifiers, so a filter on the phrase a person types - region = 'San Francisco'
# - matches NOTHING against 'SanFrancisco'.
#
# Runs on EVERY commit with no staged-path filter: the filter can come back in a
# pack YAML, an installer SQL file, or a server-side view definition. Fast (a
# scoped glob, well under a second).
#
# Two later additions, both from the same defect class reappearing one layer out:
#   RULE 1b - a PHYSICAL view must not keep a CONFIG pin when a contract view of
#     the same name has been de-scoped. FLEET_INTELLIGENCE.BACKLOAD_MATCHING and
#     FLEET_APP.BACKLOAD_MATCHING both define VW_TRAILERS /
#     VW_INTERNAL_VOLUMES / VW_EXTERNAL_OFFERS, and after the de-scope the two
#     names meant opposite things depending on which schema you read.
#   RULE 4 - de-scoping moves the filtering duty to the CONSUMER, and nothing
#     checked the consumer took it. `SELECT * FROM ...VW_TRAILERS` compiles and
#     renders a full page while returning every loaded region; the Backload
#     Matching page then posted 29 San Francisco coordinates to the Europe road
#     graph, which refused the matrix in 5 ms with ORS 6010 "out of bounds".
REGION_SCOPE_CHECK="$SKILL_DIR/scripts/check_region_scoping.py"
if [ -f "$REGION_SCOPE_CHECK" ]; then
  echo "pre-commit: region scoping check..."
  python3 "$REGION_SCOPE_CHECK" || {
    echo "pre-commit FAILED: a view is pinned to one region, or a semantic view cannot be filtered by region."
    exit 1
  }
fi

# 9. Verb JavaScript globals: a bundled verb source must not use a host API the
# Snowflake LANGUAGE JAVASCRIPT proc runtime does not have.
#
# Nothing else in the toolchain notices. tsc accepts it (the repo pulls in DOM and
# @types/node for the build-time half of the framework), esbuild bundles it, and
# `npx synapse deploy` creates the procedure cleanly - so the first symptom is an
# agent hitting a bare "<name> is not defined" mid-conversation, with no line
# number and nothing useful in VERB_ATTEMPT.
#
# That is how deep_link shipped broken: its LAST statement built the query string
# with `new URLSearchParams()`, so the verb looked up the view label, probed
# SHOW ENDPOINTS for the ingress host, and then threw. deep_link is the sanctioned
# fallback for every visual question the agent cannot draw, so its failure removed
# the only honest visual path - and the agent, handed an opaque internal error,
# told the user to escalate a repo bug to their Fleet Ops administrator.
#
# Runs on EVERY commit with no staged-path filter: the scan is 47 files and
# finishes instantly, and a bad global can arrive in a verb, a shared helper, or
# the vendored envelope. Comments and string literals are stripped first, which
# matters because these files legitimately discuss the APIs they must not call.
VERB_GLOBALS_CHECK="$SKILL_DIR/scripts/check_verb_js_globals.py"
if [ -f "$VERB_GLOBALS_CHECK" ]; then
  echo "pre-commit: verb JavaScript globals check..."
  python3 "$VERB_GLOBALS_CHECK" || {
    echo "pre-commit FAILED: a verb uses a JavaScript global the Snowflake proc runtime lacks."
    exit 1
  }
fi

# 9. Warehouse DDL drift. Runs on EVERY commit with no staged-path filter: the
# scan is fast, and a divergent spec can arrive in any .sql layer or .sh deploy
# script. Seven files used to create ROUTING_ANALYTICS with three different
# specs; because `CREATE ... IF NOT EXISTS` makes every later one a silent no-op,
# the spec an account received was decided by install order, and no existing
# gate could see it (they all verify objects were CREATED, not that they match
# the source). Comments are stripped first, which matters because these files
# quote the very DDL they must not diverge from.
WAREHOUSE_DDL_CHECK="$SKILL_DIR/scripts/check_warehouse_ddl.py"
if [ -f "$WAREHOUSE_DDL_CHECK" ]; then
  echo "pre-commit: warehouse DDL single-owner check..."
  python3 "$WAREHOUSE_DDL_CHECK" || {
    echo "pre-commit FAILED: warehouse spec drift -- scripts/warehouses.sql is the single owner."
    exit 1
  }
fi

# 10. Client-side polling must use the visibility-guarded hook. Runs on EVERY
# commit with no staged-path filter: the scan is ~139 files and finishes
# instantly. DEFAULT-DENY by design - the obvious "flag setInterval whose body
# contains fetch('/api/...')" version would have caught NONE of the six loops
# this gate was written for, because every one of them called an indirect helper.
# Opting out is possible via '// polling-gate: ui-only -- <reason>' and three
# genuine UI timers use it. Server-side trees are deliberately out of scope.
CLIENT_POLLING_CHECK="$SKILL_DIR/scripts/check_client_polling.py"
if [ -f "$CLIENT_POLLING_CHECK" ]; then
  echo "pre-commit: client polling visibility-guard check..."
  python3 "$CLIENT_POLLING_CHECK" || {
    echo "pre-commit FAILED: unguarded client polling holds a warehouse awake for a background tab."
    exit 1
  }
fi

# 11. Batch workloads must use the batch SQL transport, not the interactive one.
# This is the gate that would have caught a real shipped defect: the two-warehouse
# split LOOKED complete because both submitSqlAsync call sites were correct, while
# nothing verified that callers of the SYNCHRONOUS transport had been classified.
# Three subsystems were still interactive - the whole studio generation pipeline
# (from ONE injected argument), all of instrumentation.ts, and six heavy routes.
# A batch workload is invisible at the transport, so the check has to know which
# entry points are batch BY NAME and assert they never receive `runSql`.
BATCH_TRANSPORT_CHECK="$SKILL_DIR/scripts/check_batch_transport.py"
if [ -f "$BATCH_TRANSPORT_CHECK" ]; then
  echo "pre-commit: batch SQL transport routing check..."
  python3 "$BATCH_TRANSPORT_CHECK" || {
    echo "pre-commit FAILED: batch work on the interactive warehouse starves dashboard reads."
    exit 1
  }
fi

# 12. Solver verbs must use the ASYNC solve path. Measured, the DEFAULT
# backload_solve parameters take 38.1s and 100 vehicles / 500 loads takes 168.6s,
# against a synchronous transport that gives up at 60s (pollResult 30x2s) with the
# statement capped at 80s to stay under the ~90s SPCS ingress limit. A solver route
# that reverts to query/queryBatch still WORKS for small inputs and only breaks
# past ~40 vehicles - as a timeout that reads like an infrastructure fault rather
# than a regression, which is why this needs a gate.
SOLVER_ASYNC_CHECK="$SKILL_DIR/scripts/check_solver_async.py"
if [ -f "$SOLVER_ASYNC_CHECK" ]; then
  echo "pre-commit: solver async path check..."
  python3 "$SOLVER_ASYNC_CHECK" || {
    echo "pre-commit FAILED: a synchronous solve cannot exceed ~60s."
    exit 1
  }
fi

# 13. JS-bearing SQL must deploy with --enable-templating NONE. `snow sql` defaults
# to LEGACY templating (SnowSQL &var), where `&&` is the ESCAPE for a literal `&`,
# so deploying a JavaScript procedure without the flag rewrites every LOGICAL AND
# into a BITWISE AND. `&` does not short-circuit, so `a && a.b` becomes a null
# dereference. Measured: deploy-agent.sql has 75 `&&`; the deployed
# TOOL_BACKLOAD_SOLVE had 0 `&&` and 25 bare `&`, which is why max_loads >= ~600
# returned "unknown error". 8 of 9 JS TOOL_* procs shipped corrupted on every install.
JS_TEMPLATING_CHECK="$SKILL_DIR/scripts/check_js_proc_templating.py"
if [ -f "$JS_TEMPLATING_CHECK" ]; then
  echo "pre-commit: JS procedure templating check..."
  python3 "$JS_TEMPLATING_CHECK" || {
    echo "pre-commit FAILED: LEGACY templating corrupts && into bitwise & in JS procs."
    exit 1
  }
fi
