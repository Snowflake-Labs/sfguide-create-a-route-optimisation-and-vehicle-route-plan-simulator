#!/usr/bin/env bash
# Optional local hook - a fast-feedback convenience, NOT the enforcement point.
#   enable:  git config core.hooksPath .githooks
#
# Every gate lives in .cortex/skills/install-fleet-apps/scripts/gates.yaml and
# runs through run_gates.py. CI (.github/workflows/gates.yml) runs the full set
# - every check AND every negative test - on each pull request, whether or not
# anyone enabled this hook. That is why this file used to matter and no longer
# does: as the only runner it was opt-in, skipped ~20 gates unless matching
# paths were staged, and let a brand string sit red for three weeks unseen.
#
# Here we run the checks only (about 10 s); negative tests run in CI. For the
# full CI set locally:  python3 .cortex/skills/install-fleet-apps/scripts/run_gates.py
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec python3 .cortex/skills/install-fleet-apps/scripts/run_gates.py --checks-only
